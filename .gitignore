target/
*.swp
*.swo
.vscode/
.idea/
.DS_Store

# Local dev artefacts
data/
*.sqlite
*.db
.env
.env.*
!.env.example

# UI
web/node_modules/
web/dist/
web/.vite/

# Rust
**/*.rs.bk

# ts-rs codegen output (regenerated by cargo test --features ts-types)
bindings/

# Paper build pipeline — intermediates only.
# We do commit the rendered PDFs so reviewers can grab them without
# the full toolchain; the HTML and patched-Markdown are throwaway.
docs/paper/build/*.html
docs/paper/build/*.patched.md

# Paper submission bundles produced by
# `scripts/paper-submission-package.sh`. The script
# rebuilds everything from tracked sources on demand;
# bundles themselves are regenerable artifacts.
dist/paper/

# Study 3 — cloned upstream repos (~180 MB, each its own .git tree).
# Re-fetched on demand by studies/study3/run.sh.
studies/study3/sources/

# matplotlib caches
.cache/
**/__pycache__/

# Local-only editor / tooling overrides are listed in
# .git/info/exclude (not tracked).
